# Nur lokal hinterlegen. Diese Datei kann als .env kopiert werden.
# Benötigt: ElevenLabs Text-to-Speech und Lesen der verfügbaren Stimmen.
ELEVENLABS_API_KEY=
# EU Data Residency: Schlüssel aus dem separaten EU-Workspace verwenden.
ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io

# LiveKit-v1-Turn-Detektor in der Cloud (Projektzugang mit Inferenzberechtigung)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional; leer verwendet den offiziellen Produktions-Inferenzgateway.
LIVEKIT_INFERENCE_URL=
